  <ItemGroup>
    <GuiFiles Include="GUI\**\*" />
  </ItemGroup>

  <!-- Brushes must ship; empty GUI\Brushes would still be fine but keep deploy explicit. -->

  <PropertyGroup>
    <BannerlordGameModules>D:\SteamLibrary\steamapps\common\Mount &amp; Blade II Bannerlord\Modules</BannerlordGameModules>
    <BannerlordModuleDir>$(BannerlordGameModules)\PartyQOL</BannerlordModuleDir>
  </PropertyGroup>
  <Target Name="DeployToBannerlord" AfterTargets="Build" Condition="'$(SkipBannerlordDeploy)' != 'true'">
    <MakeDir Directories="$(BannerlordModuleDir)\bin\Win64_Shipping_Client" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(BannerlordModuleDir)\bin\Win64_Shipping_Client" SkipUnchangedFiles="false" />
    <Copy SourceFiles="$(TargetDir)$(TargetName).pdb" DestinationFolder="$(BannerlordModuleDir)\bin\Win64_Shipping_Client" SkipUnchangedFiles="false" Condition="Exists('$(TargetDir)$(TargetName).pdb')" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)\SubModule.xml" DestinationFolder="$(BannerlordModuleDir)" SkipUnchangedFiles="false" />
    <RemoveDir Directories="$(BannerlordModuleDir)\GUI" />
    <Copy SourceFiles="@(GuiFiles)" DestinationFolder="$(BannerlordModuleDir)\GUI\%(RecursiveDir)" SkipUnchangedFiles="false" />
    <!-- Drop UIExtenderEx cached PartyScreen so prefab patches rebuild next launch. -->
    <ItemGroup>
      <_PartyScreenCache Include="$(BannerlordGameModules)\Bannerlord.UIExtenderEx\CompiledPrefabs\**\*PartyScreen*" />
      <_PartyScreenCache Include="$(BannerlordGameModules)\Bannerlord.UIExtenderEx\CompiledPrefabs\**\*PartyTroopManagerPopUp*" />
      <_PartyScreenCache Include="$(BannerlordGameModules)\Bannerlord.UIExtenderEx\CompiledPrefabs\**\*PartyTroopUpgradeItem*" />
    </ItemGroup>
    <Delete Files="@(_PartyScreenCache)" ContinueOnError="true" />
    <Message Importance="high" Text="Deployed $(TargetFileName) to $(BannerlordModuleDir)" />
  </Target>

</Project>
